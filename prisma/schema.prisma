// =====================================================================
// Beauty & Cosmetics E-Commerce Platform — Prisma Schema
// Single-vendor MVP, multi-vendor-ready architecture
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// =====================================================================
// ENUMS
// =====================================================================

enum SellerType {
  PLATFORM // the single MVP "store" seller — seeded once, never customer-visible
  VENDOR   // future marketplace sellers
}

enum SellerStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AttributeInputType {
  SELECT // dropdown, e.g. Size
  COLOR  // swatch picker, e.g. Shade
  TEXT
  NUMBER
}

enum InventoryTransactionType {
  RESTOCK
  SALE
  RESERVATION
  RELEASE
  ADJUSTMENT
  RETURN
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  PARTIALLY_SHIPPED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum OrderItemStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// =====================================================================
// SELLER & MULTI-VENDOR FOUNDATION
// (MVP: exactly one Seller row exists, type = PLATFORM, seeded via migration)
// =====================================================================

model Seller {
  id             String       @id @default(cuid())
  name           String
  slug           String       @unique
  type           SellerType   @default(PLATFORM)
  status         SellerStatus @default(ACTIVE)
  email          String?
  commissionRate Decimal?     @db.Decimal(5, 2) // % — unused while type = PLATFORM
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  warehouses      Warehouse[]
  products        Product[]
  productVariants ProductVariant[]
  inventoryItems  InventoryItem[]
  cartItems       CartItem[]
  orderItems      OrderItem[]

  @@index([type, status])
}

model Warehouse {
  id         String   @id @default(cuid())
  sellerId   String
  seller     Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  name       String
  code       String
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String?
  country    String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  inventoryItems InventoryItem[]

  @@unique([sellerId, code])
  @@index([sellerId])
}

// =====================================================================
// USERS, ROLES & PERMISSIONS (RBAC — not hardcoded to admin/customer)
// =====================================================================

model Role {
  id          String   @id @default(cuid())
  name        String   @unique // "SUPER_ADMIN", "CATALOG_MANAGER", "ORDER_MANAGER", "CUSTOMER", ...
  description String?
  isSystem    Boolean  @default(false) // prevents deletion of built-in roles
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique // "product:create", "order:refund", "coupon:manage", ...
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  firstName       String
  lastName        String
  phone           String?
  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  roles        UserRole[]
  addresses    Address[]
  carts        Cart[]
  wishlist     Wishlist?
  orders       Order[]
  reviews      Review[]
  couponUsages CouponUsage[]

  @@index([deletedAt])
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model Address {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label             String? // "Home", "Work"
  fullName          String
  phone             String
  line1             String
  line2             String?
  city              String
  state             String?
  postalCode        String
  country           String
  isDefaultShipping Boolean   @default(false)
  isDefaultBilling  Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  @@index([userId])
}

// =====================================================================
// CATALOG: CATEGORY, BRAND, PRODUCT, VARIANTS, ATTRIBUTES (EAV)
// =====================================================================

model Category {
  id             String     @id @default(cuid())
  parentId       String?
  parent         Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[] @relation("CategoryTree")
  name           String
  slug           String     @unique
  description    String?    @db.Text
  imageUrl       String?
  isActive       Boolean    @default(true)
  sortOrder      Int        @default(0)
  seoTitle       String?
  seoDescription String?    @db.Text
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  products ProductCategory[]
  coupons  CouponCategory[]

  @@index([parentId])
}

model Brand {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  description    String?  @db.Text
  logoUrl        String?
  isActive       Boolean  @default(true)
  seoTitle       String?
  seoDescription String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products Product[]
}

model Product {
  id               String        @id @default(cuid())
  sellerId         String
  seller           Seller        @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  brandId          String?
  brand            Brand?        @relation(fields: [brandId], references: [id], onDelete: SetNull)
  name             String
  slug             String        @unique
  description      String?       @db.Text
  shortDescription String?
  status           ProductStatus @default(DRAFT)
  seoTitle         String?
  seoDescription   String?       @db.Text
  seoKeywords      String?
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  categories     ProductCategory[]
  variants       ProductVariant[]
  images         ProductImage[]
  ingredients    ProductIngredient[]
  tags           ProductTag[]
  reviews        Review[]
  wishlistItems  WishlistItem[]
  couponProducts CouponProduct[]
  orderItems     OrderItem[]

  @@index([sellerId, status])
  @@index([brandId])
  @@index([status])
}

model ProductCategory {
  productId  String
  categoryId String
  isPrimary  Boolean  @default(false)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

/// A purchasable SKU: one specific shade/size combination of a Product.
model ProductVariant {
  id             String    @id @default(cuid())
  productId      String
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  sellerId       String // denormalized from product.sellerId — enables per-seller SKU uniqueness & fast scoped queries
  seller         Seller    @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  sku            String
  barcode        String?
  price          Decimal   @db.Decimal(12, 2)
  compareAtPrice Decimal?  @db.Decimal(12, 2)
  costPrice      Decimal?  @db.Decimal(12, 2)
  weightGrams    Int?
  isActive       Boolean   @default(true)
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  attributeValues VariantAttributeValue[]
  images          ProductImage[]
  inventoryItems  InventoryItem[]
  cartItems       CartItem[]
  wishlistItems   WishlistItem[]
  orderItems      OrderItem[]

  @@unique([sellerId, sku])
  @@index([productId])
}

/// Global, reusable characteristic definitions: "Shade", "Size", "Skin Type", "Volume"
model Attribute {
  id        String             @id @default(cuid())
  name      String             @unique
  slug      String             @unique
  inputType AttributeInputType @default(SELECT)
  createdAt DateTime           @default(now())

  values AttributeValue[]
}

/// Specific values for an Attribute: Shade → "Rosy Pink", Size → "30ml"
model AttributeValue {
  id          String    @id @default(cuid())
  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String
  slug        String
  colorHex    String? // populated when attribute.inputType = COLOR, drives shade swatches
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  variants VariantAttributeValue[]

  @@unique([attributeId, value])
  @@index([attributeId])
}

/// Links a variant to the specific attribute values that define it (Shade=Rosy Pink + Size=30ml)
model VariantAttributeValue {
  variantId        String
  attributeValueId String
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Restrict)

  @@id([variantId, attributeValueId])
  @@index([attributeValueId])
}

model ProductImage {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String? // set when the image is specific to one variant (e.g. a shade close-up)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  position  Int             @default(0)
  isPrimary Boolean         @default(false)
  createdAt DateTime        @default(now())

  @@index([productId])
  @@index([variantId])
}

/// Global ingredient dictionary — enables "contains no X" allergen filtering without repeating text per product
model Ingredient {
  id          String   @id @default(cuid())
  name        String   @unique
  inciName    String? // International Nomenclature of Cosmetic Ingredients name
  description String?  @db.Text
  isAllergen  Boolean  @default(false)
  createdAt   DateTime @default(now())

  products ProductIngredient[]
}

model ProductIngredient {
  productId    String
  ingredientId String
  position     Int        @default(0) // ordering, as required by cosmetics labeling regulation in many regions
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@id([productId, ingredientId])
  @@index([ingredientId])
}

model Tag {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  products ProductTag[]
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

// =====================================================================
// INVENTORY
// =====================================================================

model InventoryItem {
  id                String   @id @default(cuid())
  sellerId          String // denormalized from variant.sellerId
  seller            Seller   @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  variantId         String
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouseId       String
  warehouse         Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  quantityOnHand    Int      @default(0)
  quantityReserved  Int      @default(0) // held for unpaid/processing orders
  lowStockThreshold Int      @default(5)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  transactions InventoryTransaction[]

  // quantityAvailable = quantityOnHand - quantityReserved, computed at the application/query layer
  @@unique([variantId, warehouseId])
  @@index([sellerId])
  @@index([warehouseId])
}

/// Append-only ledger of every stock movement — never update quantities without a matching row here
model InventoryTransaction {
  id              String                   @id @default(cuid())
  inventoryItemId String
  inventoryItem   InventoryItem            @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  type            InventoryTransactionType
  quantityChange  Int // positive or negative
  referenceType   String? // "ORDER", "MANUAL", "RETURN"
  referenceId     String?
  note            String?
  createdByUserId String?
  createdAt       DateTime                 @default(now())

  @@index([inventoryItemId, createdAt])
}

// =====================================================================
// CART & WISHLIST
// =====================================================================

model Cart {
  id        String    @id @default(cuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String? // for guest carts, keyed off a browser session
  currency  String    @default("USD")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiresAt DateTime?

  items CartItem[]

  @@index([userId])
  @@index([sessionId])
}

model CartItem {
  id         String         @id @default(cuid())
  cartId     String
  cart       Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  sellerId   String
  seller     Seller         @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  quantity   Int
  priceAtAdd Decimal        @db.Decimal(12, 2)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([cartId, variantId])
  @@index([sellerId])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  items WishlistItem[]
}

model WishlistItem {
  id         String          @id @default(cuid())
  wishlistId String
  wishlist   Wishlist        @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId  String? // optional — customer may wishlist a product without picking a shade yet
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())

  @@unique([wishlistId, productId, variantId])
}

// =====================================================================
// ORDERS — snapshot-based so history stays correct after catalog edits
// =====================================================================

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique // human-readable, e.g. "ORD-2026-000482"
  userId        String?
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  email         String
  status        OrderStatus @default(PENDING_PAYMENT)
  currency      String      @default("USD")
  subtotal      Decimal     @db.Decimal(12, 2)
  discountTotal Decimal     @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal     @default(0) @db.Decimal(12, 2)
  shippingTotal Decimal     @default(0) @db.Decimal(12, 2)
  grandTotal    Decimal     @db.Decimal(12, 2)
  couponCode    String?
  shippingAddress Json // full snapshot at time of order — never joined to Address
  billingAddress  Json // full snapshot at time of order — never joined to Address
  placedAt      DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  items         OrderItem[]
  payments      Payment[]
  statusHistory OrderStatusHistory[]
  couponUsages  CouponUsage[]

  @@index([userId])
  @@index([status])
  @@index([placedAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerId  String // enables splitting fulfillment/payout by seller later
  seller    Seller  @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  productId String? // nullable + SetNull: order survives even if the product is later deleted
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // --- snapshot fields: the source of truth for what was actually purchased ---
  productNameSnapshot       String
  variantSkuSnapshot        String
  variantAttributesSnapshot Json? // e.g. {"Shade":"Rosy Pink","Size":"30ml"}
  imageUrlSnapshot          String?
  unitPriceSnapshot         Decimal @db.Decimal(12, 2)

  quantity        Int
  discountAmount  Decimal         @default(0) @db.Decimal(12, 2)
  taxAmount       Decimal         @default(0) @db.Decimal(12, 2)
  lineTotal       Decimal         @db.Decimal(12, 2)
  status          OrderItemStatus @default(PENDING) // per-seller fulfillment status
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  statusHistory OrderStatusHistory[]
  reviews       Review[]

  @@index([orderId])
  @@index([sellerId])
  @@index([productId])
}

/// Generic status-change ledger — orderItemId null = order-level event, set = per-seller item event
model OrderStatusHistory {
  id              String     @id @default(cuid())
  orderId         String
  order           Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId     String?
  orderItem       OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  status          String // OrderStatus or OrderItemStatus value, stored as string to keep one shared table
  note            String?
  changedByUserId String?
  createdAt       DateTime   @default(now())

  @@index([orderId, createdAt])
  @@index([orderItemId])
}

model Payment {
  id                String          @id @default(cuid())
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          PaymentProvider
  providerPaymentId String
  amount            Decimal         @db.Decimal(12, 2)
  currency          String
  status            PaymentStatus   @default(PENDING)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([provider, providerPaymentId])
  @@index([orderId])
}

// =====================================================================
// COUPONS / PROMOTIONS
// =====================================================================

model Coupon {
  id                    String     @id @default(cuid())
  code                  String     @unique
  description           String?
  type                  CouponType
  value                 Decimal    @db.Decimal(12, 2)
  minOrderAmount        Decimal?   @db.Decimal(12, 2)
  maxDiscountAmount     Decimal?   @db.Decimal(12, 2) // caps a PERCENTAGE discount
  startsAt              DateTime?
  endsAt                DateTime?
  usageLimit            Int? // total redemptions across all customers
  usageLimitPerCustomer Int?
  isActive              Boolean    @default(true)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  deletedAt             DateTime?

  products   CouponProduct[] // empty = store-wide
  categories CouponCategory[] // empty = store-wide
  usages     CouponUsage[]

  @@index([isActive, startsAt, endsAt])
}

model CouponProduct {
  couponId  String
  productId String
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
  @@index([productId])
}

model CouponCategory {
  couponId   String
  categoryId String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([couponId, categoryId])
  @@index([categoryId])
}

model CouponUsage {
  id             String   @id @default(cuid())
  couponId       String
  coupon         Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  discountAmount Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())

  @@unique([couponId, orderId])
  @@index([userId])
}

// =====================================================================
// REVIEWS
// =====================================================================

model Review {
  id                 String       @id @default(cuid())
  productId          String
  product            Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId             String
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItemId        String? // presence + match establishes "verified purchase"
  orderItem          OrderItem?   @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  rating             Int // 1–5; enforce range via a DB check constraint or application validation
  title              String?
  body               String?      @db.Text
  status             ReviewStatus @default(PENDING)
  isVerifiedPurchase Boolean      @default(false)
  moderatedByUserId  String?
  moderatedAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?

  images ReviewImage[]

  @@unique([productId, userId])
  @@index([productId, status])
}

model ReviewImage {
  id       String @id @default(cuid())
  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  url      String
  position Int    @default(0)

  @@index([reviewId])
}
