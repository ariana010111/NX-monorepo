generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model address {
  id                String    @id
  userId            String
  label             String?
  fullName          String
  phone             String
  line1             String
  line2             String?
  city              String
  state             String?
  postalCode        String
  country           String
  isDefaultShipping Boolean   @default(false)
  isDefaultBilling  Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime
  deletedAt         DateTime?
  user              user      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Address_userId_fkey")

  @@index([userId], map: "Address_userId_idx")
}

model attribute {
  id             String              @id
  name           String              @unique(map: "Attribute_name_key")
  slug           String              @unique(map: "Attribute_slug_key")
  inputType      attribute_inputType @default(SELECT)
  createdAt      DateTime            @default(now())
  attributevalue attributevalue[]
}

model attributevalue {
  id                    String                  @id
  attributeId           String
  value                 String
  slug                  String
  colorHex              String?
  sortOrder             Int                     @default(0)
  createdAt             DateTime                @default(now())
  attribute             attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade, map: "AttributeValue_attributeId_fkey")
  variantattributevalue variantattributevalue[]

  @@unique([attributeId, value], map: "AttributeValue_attributeId_value_key")
  @@index([attributeId], map: "AttributeValue_attributeId_idx")
}

model brand {
  id             String    @id
  name           String
  slug           String    @unique(map: "Brand_slug_key")
  description    String?   @db.Text
  logoUrl        String?
  isActive       Boolean   @default(true)
  seoTitle       String?
  seoDescription String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime
  product        product[]
}

model cart {
  id        String     @id
  userId    String?
  sessionId String?
  currency  String     @default("USD")
  createdAt DateTime   @default(now())
  updatedAt DateTime
  expiresAt DateTime?
  user      user?      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Cart_userId_fkey")
  cartitem  cartitem[]

  @@index([sessionId], map: "Cart_sessionId_idx")
  @@index([userId], map: "Cart_userId_idx")
}

model cartitem {
  id             String         @id
  cartId         String
  variantId      String
  sellerId       String
  quantity       Int
  priceAtAdd     Decimal        @db.Decimal(12, 2)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime
  cart           cart           @relation(fields: [cartId], references: [id], onDelete: Cascade, map: "CartItem_cartId_fkey")
  seller         seller         @relation(fields: [sellerId], references: [id], map: "CartItem_sellerId_fkey")
  productvariant productvariant @relation(fields: [variantId], references: [id], onDelete: Cascade, map: "CartItem_variantId_fkey")

  @@unique([cartId, variantId], map: "CartItem_cartId_variantId_key")
  @@index([sellerId], map: "CartItem_sellerId_idx")
  @@index([variantId], map: "CartItem_variantId_fkey")
}

model category {
  id              String            @id
  parentId        String?
  name            String
  slug            String            @unique(map: "Category_slug_key")
  description     String?           @db.Text
  imageUrl        String?
  isActive        Boolean           @default(true)
  sortOrder       Int               @default(0)
  seoTitle        String?
  seoDescription  String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  category        category?         @relation("categoryTocategory", fields: [parentId], references: [id], map: "Category_parentId_fkey")
  other_category  category[]        @relation("categoryTocategory")
  couponcategory  couponcategory[]
  productcategory productcategory[]

  @@index([parentId], map: "Category_parentId_idx")
}

model coupon {
  id                    String           @id
  code                  String           @unique(map: "Coupon_code_key")
  description           String?
  type                  coupon_type
  value                 Decimal          @db.Decimal(12, 2)
  minOrderAmount        Decimal?         @db.Decimal(12, 2)
  maxDiscountAmount     Decimal?         @db.Decimal(12, 2)
  startsAt              DateTime?
  endsAt                DateTime?
  usageLimit            Int?
  usageLimitPerCustomer Int?
  isActive              Boolean          @default(true)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime
  deletedAt             DateTime?
  couponcategory        couponcategory[]
  couponproduct         couponproduct[]
  couponusage           couponusage[]

  @@index([isActive, startsAt, endsAt], map: "Coupon_isActive_startsAt_endsAt_idx")
}

model couponcategory {
  couponId   String
  categoryId String
  category   category @relation(fields: [categoryId], references: [id], onDelete: Cascade, map: "CouponCategory_categoryId_fkey")
  coupon     coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade, map: "CouponCategory_couponId_fkey")

  @@id([couponId, categoryId])
  @@index([categoryId], map: "CouponCategory_categoryId_idx")
}

model couponproduct {
  couponId  String
  productId String
  coupon    coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade, map: "CouponProduct_couponId_fkey")
  product   product @relation(fields: [productId], references: [id], onDelete: Cascade, map: "CouponProduct_productId_fkey")

  @@id([couponId, productId])
  @@index([productId], map: "CouponProduct_productId_idx")
}

model couponusage {
  id             String   @id
  couponId       String
  userId         String
  orderId        String
  discountAmount Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  coupon         coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade, map: "CouponUsage_couponId_fkey")
  order          order    @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "CouponUsage_orderId_fkey")
  user           user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "CouponUsage_userId_fkey")

  @@unique([couponId, orderId], map: "CouponUsage_couponId_orderId_key")
  @@index([orderId], map: "CouponUsage_orderId_fkey")
  @@index([userId], map: "CouponUsage_userId_idx")
}

model ingredient {
  id                String              @id
  name              String              @unique(map: "Ingredient_name_key")
  inciName          String?
  description       String?             @db.Text
  isAllergen        Boolean             @default(false)
  createdAt         DateTime            @default(now())
  productingredient productingredient[]
}

model inventoryitem {
  id                   String                 @id
  sellerId             String
  variantId            String
  warehouseId          String
  quantityOnHand       Int                    @default(0)
  quantityReserved     Int                    @default(0)
  lowStockThreshold    Int                    @default(5)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  seller               seller                 @relation(fields: [sellerId], references: [id], map: "InventoryItem_sellerId_fkey")
  productvariant       productvariant         @relation(fields: [variantId], references: [id], onDelete: Cascade, map: "InventoryItem_variantId_fkey")
  warehouse            warehouse              @relation(fields: [warehouseId], references: [id], map: "InventoryItem_warehouseId_fkey")
  inventorytransaction inventorytransaction[]

  @@unique([variantId, warehouseId], map: "InventoryItem_variantId_warehouseId_key")
  @@index([sellerId], map: "InventoryItem_sellerId_idx")
  @@index([warehouseId], map: "InventoryItem_warehouseId_idx")
}

model inventorytransaction {
  id              String                    @id
  inventoryItemId String
  type            inventorytransaction_type
  quantityChange  Int
  referenceType   String?
  referenceId     String?
  note            String?
  createdByUserId String?
  createdAt       DateTime                  @default(now())
  inventoryitem   inventoryitem             @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade, map: "InventoryTransaction_inventoryItemId_fkey")

  @@index([inventoryItemId, createdAt], map: "InventoryTransaction_inventoryItemId_createdAt_idx")
}

model order {
  id                 String               @id
  orderNumber        String               @unique(map: "Order_orderNumber_key")
  userId             String?
  email              String
  status             order_status         @default(PENDING_PAYMENT)
  currency           String               @default("USD")
  subtotal           Decimal              @db.Decimal(12, 2)
  discountTotal      Decimal              @default(0.00) @db.Decimal(12, 2)
  taxTotal           Decimal              @default(0.00) @db.Decimal(12, 2)
  shippingTotal      Decimal              @default(0.00) @db.Decimal(12, 2)
  grandTotal         Decimal              @db.Decimal(12, 2)
  couponCode         String?
  shippingAddress    Json
  billingAddress     Json
  placedAt           DateTime             @default(now())
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  couponusage        couponusage[]
  user               user?                @relation(fields: [userId], references: [id], map: "Order_userId_fkey")
  orderitem          orderitem[]
  orderstatushistory orderstatushistory[]
  payment            payment[]

  @@index([placedAt], map: "Order_placedAt_idx")
  @@index([status], map: "Order_status_idx")
  @@index([userId], map: "Order_userId_idx")
}

model orderitem {
  id                        String               @id
  orderId                   String
  sellerId                  String
  productId                 String?
  variantId                 String?
  productNameSnapshot       String
  variantSkuSnapshot        String
  variantAttributesSnapshot Json?
  imageUrlSnapshot          String?
  unitPriceSnapshot         Decimal              @db.Decimal(12, 2)
  quantity                  Int
  discountAmount            Decimal              @default(0.00) @db.Decimal(12, 2)
  taxAmount                 Decimal              @default(0.00) @db.Decimal(12, 2)
  lineTotal                 Decimal              @db.Decimal(12, 2)
  status                    orderitem_status     @default(PENDING)
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime
  order                     order                @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "OrderItem_orderId_fkey")
  product                   product?             @relation(fields: [productId], references: [id], map: "OrderItem_productId_fkey")
  seller                    seller               @relation(fields: [sellerId], references: [id], map: "OrderItem_sellerId_fkey")
  productvariant            productvariant?      @relation(fields: [variantId], references: [id], map: "OrderItem_variantId_fkey")
  orderstatushistory        orderstatushistory[]
  review                    review[]

  @@index([orderId], map: "OrderItem_orderId_idx")
  @@index([productId], map: "OrderItem_productId_idx")
  @@index([sellerId], map: "OrderItem_sellerId_idx")
  @@index([variantId], map: "OrderItem_variantId_fkey")
}

model orderstatushistory {
  id              String     @id
  orderId         String
  orderItemId     String?
  status          String
  note            String?
  changedByUserId String?
  createdAt       DateTime   @default(now())
  order           order      @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "OrderStatusHistory_orderId_fkey")
  orderitem       orderitem? @relation(fields: [orderItemId], references: [id], onDelete: Cascade, map: "OrderStatusHistory_orderItemId_fkey")

  @@index([orderId, createdAt], map: "OrderStatusHistory_orderId_createdAt_idx")
  @@index([orderItemId], map: "OrderStatusHistory_orderItemId_idx")
}

model passwordresettoken {
  id        String    @id
  token     String    @unique(map: "PasswordResetToken_token_key")
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      user      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "PasswordResetToken_userId_fkey")

  @@index([userId, expiresAt], map: "PasswordResetToken_userId_expiresAt_idx")
}

model payment {
  id                String           @id
  orderId           String
  provider          payment_provider
  providerPaymentId String
  amount            Decimal          @db.Decimal(12, 2)
  currency          String
  status            payment_status   @default(PENDING)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime
  order             order            @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "Payment_orderId_fkey")

  @@unique([provider, providerPaymentId], map: "Payment_provider_providerPaymentId_key")
  @@index([orderId], map: "Payment_orderId_idx")
}

model permission {
  id             String           @id
  name           String           @unique(map: "Permission_name_key")
  description    String?
  createdAt      DateTime         @default(now())
  rolepermission rolepermission[]
}

model product {
  id                String              @id
  sellerId          String
  brandId           String?
  name              String
  slug              String              @unique(map: "Product_slug_key")
  description       String?             @db.Text
  shortDescription  String?
  status            product_status      @default(DRAFT)
  seoTitle          String?
  seoDescription    String?             @db.Text
  seoKeywords       String?
  publishedAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  deletedAt         DateTime?
  couponproduct     couponproduct[]
  orderitem         orderitem[]
  brand             brand?              @relation(fields: [brandId], references: [id], map: "Product_brandId_fkey")
  seller            seller              @relation(fields: [sellerId], references: [id], map: "Product_sellerId_fkey")
  productcategory   productcategory[]
  productimage      productimage[]
  productingredient productingredient[]
  producttag        producttag[]
  productvariant    productvariant[]
  review            review[]
  storevisit        storevisit[]
  wishlistitem      wishlistitem[]

  @@index([brandId], map: "Product_brandId_idx")
  @@index([sellerId, status], map: "Product_sellerId_status_idx")
  @@index([status], map: "Product_status_idx")
}

model productcategory {
  productId  String
  categoryId String
  isPrimary  Boolean  @default(false)
  category   category @relation(fields: [categoryId], references: [id], onDelete: Cascade, map: "ProductCategory_categoryId_fkey")
  product    product  @relation(fields: [productId], references: [id], onDelete: Cascade, map: "ProductCategory_productId_fkey")

  @@id([productId, categoryId])
  @@index([categoryId], map: "ProductCategory_categoryId_idx")
}

model productimage {
  id             String          @id
  productId      String
  variantId      String?
  // LongText: without it, Prisma's default MySQL mapping for String is
  // VARCHAR(191), which is far too short for the data: URI base64 payloads
  // produced by the admin's "attach from computer" image upload.
  url            String          @db.LongText
  altText        String?
  position       Int             @default(0)
  isPrimary      Boolean         @default(false)
  createdAt      DateTime        @default(now())
  product        product         @relation(fields: [productId], references: [id], onDelete: Cascade, map: "ProductImage_productId_fkey")
  productvariant productvariant? @relation(fields: [variantId], references: [id], onDelete: Cascade, map: "ProductImage_variantId_fkey")

  @@index([productId], map: "ProductImage_productId_idx")
  @@index([variantId], map: "ProductImage_variantId_idx")
}

model productingredient {
  productId    String
  ingredientId String
  position     Int        @default(0)
  ingredient   ingredient @relation(fields: [ingredientId], references: [id], map: "ProductIngredient_ingredientId_fkey")
  product      product    @relation(fields: [productId], references: [id], onDelete: Cascade, map: "ProductIngredient_productId_fkey")

  @@id([productId, ingredientId])
  @@index([ingredientId], map: "ProductIngredient_ingredientId_idx")
}

model producttag {
  productId String
  tagId     String
  product   product @relation(fields: [productId], references: [id], onDelete: Cascade, map: "ProductTag_productId_fkey")
  tag       tag     @relation(fields: [tagId], references: [id], onDelete: Cascade, map: "ProductTag_tagId_fkey")

  @@id([productId, tagId])
  @@index([tagId], map: "ProductTag_tagId_idx")
}

model productvariant {
  id                    String                  @id
  productId             String
  sellerId              String
  sku                   String
  barcode               String?
  price                 Decimal                 @db.Decimal(12, 2)
  compareAtPrice        Decimal?                @db.Decimal(12, 2)
  costPrice             Decimal?                @db.Decimal(12, 2)
  weightGrams           Int?
  isActive              Boolean                 @default(true)
  sortOrder             Int                     @default(0)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  deletedAt             DateTime?
  cartitem              cartitem[]
  inventoryitem         inventoryitem[]
  orderitem             orderitem[]
  productimage          productimage[]
  product               product                 @relation(fields: [productId], references: [id], onDelete: Cascade, map: "ProductVariant_productId_fkey")
  seller                seller                  @relation(fields: [sellerId], references: [id], map: "ProductVariant_sellerId_fkey")
  variantattributevalue variantattributevalue[]
  wishlistitem          wishlistitem[]

  @@unique([sellerId, sku], map: "ProductVariant_sellerId_sku_key")
  @@index([productId], map: "ProductVariant_productId_idx")
}

model refreshtoken {
  id        String    @id
  token     String    @unique(map: "RefreshToken_token_key")
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      user      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "RefreshToken_userId_fkey")

  @@index([userId, expiresAt], map: "RefreshToken_userId_expiresAt_idx")
}

model review {
  id                 String        @id
  productId          String
  userId             String
  orderItemId        String?
  rating             Int
  title              String?
  body               String?       @db.Text
  status             review_status @default(PENDING)
  isVerifiedPurchase Boolean       @default(false)
  moderatedByUserId  String?
  moderatedAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime
  deletedAt          DateTime?
  orderitem          orderitem?    @relation(fields: [orderItemId], references: [id], map: "Review_orderItemId_fkey")
  product            product       @relation(fields: [productId], references: [id], onDelete: Cascade, map: "Review_productId_fkey")
  user               user          @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Review_userId_fkey")
  reviewimage        reviewimage[]

  @@unique([productId, userId], map: "Review_productId_userId_key")
  @@index([orderItemId], map: "Review_orderItemId_fkey")
  @@index([productId, status], map: "Review_productId_status_idx")
  @@index([userId], map: "Review_userId_fkey")
}

model reviewimage {
  id       String @id
  reviewId String
  url      String
  position Int    @default(0)
  review   review @relation(fields: [reviewId], references: [id], onDelete: Cascade, map: "ReviewImage_reviewId_fkey")

  @@index([reviewId], map: "ReviewImage_reviewId_idx")
}

model role {
  id             String           @id
  name           String           @unique(map: "Role_name_key")
  description    String?
  isSystem       Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  rolepermission rolepermission[]
  userrole       userrole[]
}

model rolepermission {
  roleId       String
  permissionId String
  permission   permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, map: "RolePermission_permissionId_fkey")
  role         role       @relation(fields: [roleId], references: [id], onDelete: Cascade, map: "RolePermission_roleId_fkey")

  @@id([roleId, permissionId])
  @@index([permissionId], map: "RolePermission_permissionId_idx")
}

model seller {
  id             String           @id
  name           String
  slug           String           @unique(map: "Seller_slug_key")
  type           seller_type      @default(PLATFORM)
  status         seller_status    @default(ACTIVE)
  email          String?
  commissionRate Decimal?         @db.Decimal(5, 2)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  cartitem       cartitem[]
  inventoryitem  inventoryitem[]
  orderitem      orderitem[]
  product        product[]
  productvariant productvariant[]
  warehouse      warehouse[]

  @@index([type, status], map: "Seller_type_status_idx")
}

model storevisit {
  id        String   @id
  /// Authenticated user, NULL for anonymous/guest visitors.
  userId    String?
  /// Product page being viewed, NULL for non-product pages.
  productId String?
  /// Anonymous session identifier (e.g. cookie/localStorage key).
  sessionId String?
  /// URL path of the visited page (required).
  path      String
  /// HTTP Referer header, if present.
  referrer  String?
  /// User-Agent string; stored as Text to avoid 191-char MySQL limit.
  userAgent String?  @db.Text
  /// One-way hash (SHA-256) of the visitor IP for analytics without PII.
  ipHash    String?
  createdAt DateTime @default(now())
  product   product? @relation(fields: [productId], references: [id], onDelete: SetNull, map: "StoreVisit_productId_fkey")
  user      user?    @relation(fields: [userId], references: [id], onDelete: SetNull, map: "StoreVisit_userId_fkey")

  /// Temporal range queries per user (profile / analytics).
  @@index([userId, createdAt], map: "StoreVisit_userId_createdAt_idx")
  /// Temporal range queries per product (top-viewed analytics).
  @@index([productId, createdAt], map: "StoreVisit_productId_createdAt_idx")
  /// Session-scoped visit reconstruction.
  @@index([sessionId], map: "StoreVisit_sessionId_idx")
  /// Global time-series analytics (new-vs-returning, daily unique sessions).
  @@index([createdAt], map: "StoreVisit_createdAt_idx")
}

model tag {
  id         String       @id
  name       String       @unique(map: "Tag_name_key")
  slug       String       @unique(map: "Tag_slug_key")
  producttag producttag[]
}

model user {
  id                 String               @id
  email              String               @unique(map: "User_email_key")
  passwordHash       String
  firstName          String
  lastName           String
  phone              String?
  isActive           Boolean              @default(true)
  emailVerifiedAt    DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  deletedAt          DateTime?
  address            address[]
  cart               cart[]
  couponusage        couponusage[]
  order              order[]
  passwordresettoken passwordresettoken[]
  refreshtoken       refreshtoken[]
  review             review[]
  storevisit         storevisit[]
  userrole           userrole[]
  wishlist           wishlist?

  @@index([deletedAt], map: "User_deletedAt_idx")
}

model userrole {
  userId String
  roleId String
  role   role   @relation(fields: [roleId], references: [id], onDelete: Cascade, map: "UserRole_roleId_fkey")
  user   user   @relation(fields: [userId], references: [id], onDelete: Cascade, map: "UserRole_userId_fkey")

  @@id([userId, roleId])
  @@index([roleId], map: "UserRole_roleId_idx")
}

model variantattributevalue {
  variantId        String
  attributeValueId String
  attributevalue   attributevalue @relation(fields: [attributeValueId], references: [id], map: "VariantAttributeValue_attributeValueId_fkey")
  productvariant   productvariant @relation(fields: [variantId], references: [id], onDelete: Cascade, map: "VariantAttributeValue_variantId_fkey")

  @@id([variantId, attributeValueId])
  @@index([attributeValueId], map: "VariantAttributeValue_attributeValueId_idx")
}

model warehouse {
  id            String          @id
  sellerId      String
  name          String
  code          String
  line1         String
  line2         String?
  city          String
  state         String?
  postalCode    String?
  country       String
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  inventoryitem inventoryitem[]
  seller        seller          @relation(fields: [sellerId], references: [id], onDelete: Cascade, map: "Warehouse_sellerId_fkey")

  @@unique([sellerId, code], map: "Warehouse_sellerId_code_key")
  @@index([sellerId], map: "Warehouse_sellerId_idx")
}

model wishlist {
  id           String         @id
  userId       String         @unique(map: "Wishlist_userId_key")
  createdAt    DateTime       @default(now())
  user         user           @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Wishlist_userId_fkey")
  wishlistitem wishlistitem[]
}

model wishlistitem {
  id             String          @id
  wishlistId     String
  productId      String
  variantId      String?
  createdAt      DateTime        @default(now())
  product        product         @relation(fields: [productId], references: [id], onDelete: Cascade, map: "WishlistItem_productId_fkey")
  productvariant productvariant? @relation(fields: [variantId], references: [id], onDelete: Cascade, map: "WishlistItem_variantId_fkey")
  wishlist       wishlist        @relation(fields: [wishlistId], references: [id], onDelete: Cascade, map: "WishlistItem_wishlistId_fkey")

  @@unique([wishlistId, productId, variantId], map: "WishlistItem_wishlistId_productId_variantId_key")
  @@index([productId], map: "WishlistItem_productId_fkey")
