{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@beauty-platform-validated/api-client": [
        "./libs/shared/api-client/src/index.ts"
      ],
      "@beauty-platform-validated/shared-ui": ["./libs/shared/ui/src/index.ts"],
      "@beauty-platform-validated/shared-util": [
        "./libs/shared/util/src/index.ts"
      ],
      "@beauty-platform-validated/storefront-data-access": [
        "./libs/storefront/data-access/src/index.ts"
      ],
      "@beauty-platform-validated/storefront-feature-cart": [
        "./libs/storefront/feature-cart/src/index.ts"
      ],
      "@beauty-platform-validated/storefront-feature-catalog": [
        "./libs/storefront/feature-catalog/src/index.ts"
      ],
      "@beauty-platform-validated/admin-data-access": [
        "./libs/admin/data-access/src/index.ts"
      ],
      "@beauty-platform-validated/admin-feature-catalog-mgmt": [
        "./libs/admin/feature-catalog-mgmt/src/index.ts"
      ],
      "@beauty-platform-validated/storefront-feature-checkout": [
        "./libs/storefront/feature-checkout/src/index.ts"
      ],
      "@beauty-platform-validated/admin-feature-orders-mgmt": [
        "./libs/admin/feature-orders-mgmt/src/index.ts"
      ]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
