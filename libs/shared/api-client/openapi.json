  "info": {
    "title": "Beauty Platform API",
    "description": "",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "ProductImageDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "altText": {
            "type": "string"
          },
          "isPrimary": {
            "type": "boolean"
          }
        },
        "required": [
          "url",
          "isPrimary"
        ]
      },
      "VariantAttributeDto": {
        "type": "object",
        "properties": {
          "attributeName": {
            "type": "string",
            "example": "Shade"
          },
          "value": {
            "type": "string",
            "example": "Rosy Pink"
          },
          "colorHex": {
            "type": "string",
            "example": "#c97b8f"
          }
        },
        "required": [
          "attributeName",
          "value"
        ]
      },
      "ProductVariantDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "compareAtPrice": {
            "type": "number"
          },
          "isActive": {
            "type": "boolean"
          },
          "attributes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VariantAttributeDto"
            }
          },
          "imageUrl": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "sku",
          "price",
          "isActive",
          "attributes"
        ]
      },
      "ProductResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "shortDescription": {
            "type": "string"
          },
          "brandName": {
            "type": "string"
          },
          "brandSlug": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "images": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductImageDto"
            }
          },
          "variants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductVariantDto"
            }
          },
          "fromPrice": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "status",
          "images",
          "variants"
        ]
      },
      "CreateProductDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Velvet Matte Lipstick"
          },
          "slug": {
            "type": "string",
            "example": "velvet-matte-lipstick"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "slug"
        ]
      },
      "CategoryResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "parentId": {
            "type": "string",
            "nullable": true
          },
          "imageUrl": {
            "type": "string"
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CategoryResponseDto"
            }
          }
        },
        "required": [
          "id",
          "name",
          "slug"
        ]
      },
      "BrandResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "logoUrl": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "slug"
        ]
      }
    }
  }
}